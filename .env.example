# Select "mock" for the built-in local demo or "openai" for the model-backed planner.
AGENT_PLANNER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# A write is allowed only when the caller explicitly sets cart_write_authorized=true.
CART_WRITE_POLICY=authorized_only
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=2
SERVICE_API_TOKEN=

# These values point to APIs owned by other repositories. They are intentionally blank.
CATALOG_API_BASE_URL=
CATALOG_SEARCH_PATH=/products/search
CART_API_BASE_URL=
CART_GET_PATH=/carts/{cart_id}
CART_ADD_ITEMS_PATH=/carts/{cart_id}/items
